---
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "../styles/idotai.scss";
import Header from "../components/Header.astro";
import Feedback from "../components/Feedback.astro";
import { SkipLink, Footer } from "@i-dot-ai-npm/component-library-solid";
import { checkLitellmHealth } from "../lib/litellm";

export interface Props {
  title: string;
  serviceName?: string;
}

const { title, serviceName = "AI Gateway" } = Astro.props;
// Set by middleware.ts once the caller passes authorisation; unset on the
// public pages (e.g. /unauthorised) middleware.ts lets through unchecked.
const userEmail = (await Astro.session?.get("user-email")) ?? null;
// Checked on every page render, not cached: this is a small, cheap,
// unauthenticated call to LiteLLM's own readiness probe (see lib/litellm.ts),
// and putting it in the shared layout is what makes the status visible
// everywhere rather than only on its own page.
const litellmHealth = await checkLitellmHealth();

// PostHog client-side tracking - read from runtime env vars and pass to client
// via define:vars (import.meta.env.PUBLIC_* is build-time only).
const posthogKey = process.env.PUBLIC_POSTHOG_KEY ?? "";
const posthogHost =
  process.env.PUBLIC_POSTHOG_HOST || "https://eu.i.posthog.com";
---

<html lang="en" class="govuk-template">
  <head>
    <meta charset="utf-8" />
    <title>{title} - {serviceName}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#2b2b2b" />
    <link rel="icon" sizes="48x48" href="/assets/images/favicon.ico" />
    <link
      rel="icon"
      sizes="any"
      href="/assets/images/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="mask-icon"
      href="/assets/images/govuk-icon-mask.svg"
      color="#2b2b2b"
    />
    <link rel="apple-touch-icon" href="/assets/images/govuk-icon-180.png" />
    <link rel="manifest" href="/assets/manifest.json" />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/posthog-js@1/dist/web/array.full.iife.min.js"
    ></script>
    <script is:inline define:vars={{ posthogKey, posthogHost }}>
      // Client-side PostHog tracking for referrer and UTM data.
      if (posthogKey) {
        posthog.init(posthogKey, {
          api_host: posthogHost,
          persistence: "memory",
          autocapture: false,
          capture_pageleave: true,
        });
      }
    </script>
  </head>
  <body class="govuk-template__body govuk-template__body--iai-theme">
    <script is:inline>
      document.body.className +=
        " js-enabled" +
        ("noModule" in HTMLScriptElement.prototype
          ? " govuk-frontend-supported"
          : "");
    </script>

    <SkipLink href="#main-content">Skip to main content</SkipLink>

    <Header
      serviceName={serviceName}
      userEmail={userEmail}
      litellmHealth={litellmHealth}
    />

    <slot name="hero" />

    <div class="govuk-width-container">
      <main class="govuk-main-wrapper" id="main-content">
        <slot />
      </main>
    </div>

    <Feedback />

    <Footer />

    <script>
      import { initAll } from "govuk-frontend";
      import { initAllIAIDesignSystem } from "@i-dot-ai-npm/component-library-frontend";
      initAll();
      initAllIAIDesignSystem();
    </script>
  </body>
</html>
