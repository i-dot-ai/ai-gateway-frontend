---
import { Chart } from "@i-dot-ai-npm/component-library-solid";
import type { ChartColour } from "@i-dot-ai-npm/component-library-frontend";
import { formatChartValue, CHART_INTL_FORMATS } from "../lib/usage";

/**
 * One stacked bar-chart panel for the "Your usage" tabs - a metric bucketed
 * over the selected period, split into stacked series (per model for
 * spend/tokens, or succeeded/failed for requests). Rendered by the i.AI
 * Design System's solid Chart component and enhanced by initAllIAIDesignSystem
 * (in the layout script), which draws the canvas from the component's data
 * table; the table is the no-JS fallback.
 */
export interface Props {
  /** Unique panel id - several panels share the page. */
  id: string;
  /** Short x-axis labels, e.g. "23 Sep". */
  labels: string[];
  /** Stacked series, drawn bottom-to-top in order. */
  datasets: Array<{ label: string; data: number[] }>;
  /** i.AI chart-colour names, applied to the series in order. Omit for the default palette order. */
  colours?: ChartColour[];
  /** Units shown under the chart's heading, e.g. "Tokens". */
  yLabel: string;
  /** How to format values, in both the chart (axis/tooltip) and the table. */
  valueFormat: "count" | "spend" | "tokens" | "carbon";
  /** Accessible name of the chart. */
  caption: string;
}

const { id, labels, datasets, colours, yLabel, valueFormat, caption } =
  Astro.props;
const intlFormat = CHART_INTL_FORMATS[valueFormat];
---

<Chart
  id={id}
  class="app-usage-chart"
  variant="stacked-bar"
  title={caption}
  description={yLabel}
  data={{
    heading: "Date",
    labels,
    datasets: datasets.map((d, i) => ({
      label: d.label,
      data: d.data,
      colour: colours?.[i],
    })),
  }}
  format={(value: number) => formatChartValue(value, valueFormat)}
  {...(intlFormat
    ? { "data-iai-chart-format": JSON.stringify(intlFormat) }
    : {})}
/>

<style>
  /* The tab panels carry their own visible headings, so the chart's title only
     names the canvas and its data table - hide it on screen (as
     govuk-visually-hidden does). */
  :global(.app-usage-chart > h3) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Keep the units line small and muted, as before. */
  :global(.app-usage-chart > .iai-chart__description) {
    margin-bottom: 10px;
    font-size: 0.875rem;
    line-height: 1.1428571429;
    color: var(--govuk-secondary-text-colour);
  }
</style>
