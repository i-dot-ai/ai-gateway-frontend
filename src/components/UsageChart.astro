---
import { formatChartValue, CHART_INTL_FORMATS } from "../lib/usage";

/**
 * One stacked bar-chart panel for the "Your usage" tabs - a metric bucketed
 * over the selected period, split into stacked series (per model for
 * spend/tokens, or succeeded/failed for requests). Drawn by the i.AI Design
 * System chart component from this data table; initAllIAIDesignSystem (in the
 * layout script) swaps in the canvas, where the tooltip lists each part of a
 * stack with the stack's total. The table is the no-JS fallback.
 */
export interface Props {
  /** Unique panel id - several panels share the page. */
  id: string;
  /** Short x-axis labels, e.g. "23 Sep". */
  labels: string[];
  /** Stacked series, drawn bottom-to-top in order. */
  datasets: Array<{ label: string; data: number[] }>;
  /** i.AI chart-colour names, applied to the series in order. Omit for the default palette order. */
  colours?: string[];
  /** Units shown under the chart's heading, e.g. "Tokens". */
  yLabel: string;
  /** How to format values, in both the chart (axis/tooltip) and the table. */
  valueFormat: "count" | "spend" | "tokens" | "carbon";
  /** Accessible name of the chart. */
  caption: string;
}

const { id, labels, datasets, colours, yLabel, valueFormat, caption } =
  Astro.props;
const intlFormat = CHART_INTL_FORMATS[valueFormat];
---

<div
  id={id}
  class="iai-chart iai-chart--stacked-bar"
  data-module="iai-chart"
  data-iai-chart-format={intlFormat ? JSON.stringify(intlFormat) : undefined}
>
  <h3 class="govuk-visually-hidden">{caption}</h3>
  <p class="iai-chart__description govuk-body-s app-muted govuk-!-margin-bottom-2">
    {yLabel}
  </p>
  <details class="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">View chart data</span>
    </summary>
    <div class="govuk-details__text">
      <table class="govuk-table govuk-!-margin-bottom-0">
        <caption class="govuk-visually-hidden">{caption}</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">
              Date
            </th>
            {datasets.map((d, i) => (
              <th
                scope="col"
                class="govuk-table__header govuk-table__header--numeric"
                data-iai-chart-colour={colours?.[i]}
              >
                {d.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {labels.map((label, row) => (
            <tr class="govuk-table__row">
              <th scope="row" class="govuk-table__header">
                {label}
              </th>
              {datasets.map((d) => (
                <td
                  class="govuk-table__cell govuk-table__cell--numeric"
                  data-value={d.data[row]}
                >
                  {formatChartValue(d.data[row] ?? 0, valueFormat)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>
