---
import { Chart } from "@i-dot-ai-npm/component-library-solid";
import { formatChartValue, formatDay, CHART_INTL_FORMATS } from "../lib/usage";

/**
 * One area-chart panel for the trends page - a metric over time, rendered by
 * the i.AI Design System's solid Chart component and enhanced by
 * initAllIAIDesignSystem (in the layout script), which draws the canvas from
 * the component's data table; the table is the no-JS fallback.
 */
export interface TrendsChartData {
  /** YYYY-MM-DD each point's bucket starts on - the x-axis. */
  labels: ReadonlyArray<string>;
  /** What a point is, for the series name ("Tokens"). */
  label: string;
  data: ReadonlyArray<number>;
}

export interface Props {
  /** Unique panel id - several panels share the page. */
  id: string;
  title: string;
  chartData: TrendsChartData;
  /** How to format values, in both the chart (axis/tooltip) and the table. */
  valueFormat: "count" | "spend" | "tokens";
}

const { id, title, chartData, valueFormat } = Astro.props;
const intlFormat = CHART_INTL_FORMATS[valueFormat];
---

<Chart
  id={id}
  class="app-trend-chart"
  variant="area"
  title={title}
  data={{
    heading: "Date",
    labels: chartData.labels.map(formatDay),
    datasets: [
      { label: chartData.label, data: [...chartData.data], colour: "blue" },
    ],
  }}
  format={(value: number) => formatChartValue(value, valueFormat)}
  {...(intlFormat
    ? { "data-iai-chart-format": JSON.stringify(intlFormat) }
    : {})}
/>

<style>
  :global(.app-trend-chart) {
    margin-bottom: 30px;
  }

  /* Keep the chart's title the same size as before (h3 styled as
     govuk-heading-s; the kit renders it as govuk-heading-m). */
  :global(.app-trend-chart > h3) {
    margin-bottom: 10px;
    font-size: 1.1875rem;
    line-height: 1.3157894737;
  }
</style>
