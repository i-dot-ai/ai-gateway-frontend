---
import StatTile from "../../components/StatTile.astro";
import TrendsChart from "../../components/TrendsChart.astro";
import GovukLayout from "../../layouts/GovukLayout.astro";
import {
  Button,
  Details,
  DetailsSummary,
  DetailsText,
  ErrorMessage,
  ErrorSummary,
  ErrorSummaryBody,
  ErrorSummaryItem,
  ErrorSummaryList,
  ErrorSummaryTitle,
  FormGroup,
  Hint,
  Label,
} from "@i-dot-ai-npm/component-library-astro";
import Input from "../../components/Input.astro";
import { getAllModels, getCosts } from "../../lib/litellm";
import { TIMEFRAMES, parseOption, type Timeframe } from "../../lib/costs";
import {
  bucketImpact,
  buildImpactIndex,
  coveragePct,
  formatCo2,
  formatEnergy,
  formatRange,
  impactPerDay,
  rangeMid,
  sumImpact,
} from "../../lib/impact";
import {
  ENTITY_DIMENSIONS,
  MAX_CUSTOM_DAYS,
  bucketAlignedStart,
  buildTrends,
  excludeHealthCheck,
  parseTrendRange,
  pctChange,
  presetParams,
  rangeParams,
  trendFetchStart,
  trendGranularityFor,
  trendTotals,
  type EntityDimension,
} from "../../lib/trends";
import {
  formatChartDate,
  formatFailureRate,
  formatSpan,
  formatSpendCompact,
  formatTokens,
  formatRequests,
  listDates,
  shiftDate,
  todayUtc,
} from "../../lib/usage";

const params = Astro.url.searchParams;
const today = todayUtc();

// One range drives the whole page: a preset (last 7/30/90 days, ending today)
// or a custom from/to. Defaults to the last 30 days, which keeps the first load
// light (the platform-wide cost scan grows with the range).
const range = parseTrendRange(params, today);
const { startDate, endDate, days } = range;

// The users/teams toggle only changes what the adoption chart counts; the rest
// of the page is dimension-independent. Default to users.
const entity = parseOption(params.get("entity"), ENTITY_DIMENSIONS, "users");
const entityMeta = ENTITY_DIMENSIONS.find((d) => d.value === entity)!;

// The charts plot whole buckets ending today, so their x-axis can start a few
// days before the range. The tiles stay on the exact range.
const granularity = trendGranularityFor(days);
const chartStart = bucketAlignedStart(startDate, endDate, granularity);
const displayDates = listDates(startDate, endDate);

// The tiles carry a change indicator against the immediately preceding window
// of the same length. One fetch covers it, the range and the chart lead-in.
const prevStart = trendFetchStart(range);
// The model list is the (cached) key for estimating environmental impact per
// cost row; it loads alongside the costs rather than after them.
const [result, modelList] = await Promise.all([
  getCosts(prevStart, endDate),
  getAllModels(),
]);
// The internal health-check probe never represents real usage, so it's
// stripped before any aggregation.
const costs = excludeHealthCheck(result.costs);
const chartDates = listDates(chartStart, endDate);
const trends = buildTrends(costs, chartDates, granularity);
const totals = trendTotals(costs, displayDates);
const prevDates = listDates(prevStart, shiftDate(startDate, -1));
const prevTotals = result.error ? null : trendTotals(costs, prevDates);

// Environmental impact, estimated at read time from each row's output tokens
// (ADR-0005). One pass over the whole fetched window, which runs from the
// previous window through the display range; the tiles, the previous window
// and the chart are slices of it. Models with no estimate contribute nothing
// but count towards coverage, so the tile can say how much usage it covers.
const impactDays = impactPerDay(costs, buildImpactIndex(modelList.models), [
  ...prevDates,
  ...displayDates,
]);
const prevImpact = sumImpact(impactDays.slice(0, prevDates.length));
const impact = sumImpact(impactDays.slice(prevDates.length));
const impactBuckets = bucketImpact(
  impactDays.filter((d) => d.date >= chartStart),
  granularity,
);
const coverageRounded = Math.round(coveragePct(impact));

// Spell out the window in plain dates so "30 days" can't be read as a calendar month.
const periodNoun = `${days} days`;
const spanText = `${formatChartDate(startDate)} to ${formatChartDate(endDate)}`;
const rangeSummary = range.preset
  ? `Summary from the last ${periodNoun} (${spanText}), compared with the ${periodNoun} before.`
  : `Summary from ${spanText} (${periodNoun}), compared with the ${periodNoun} before.`;

// Links carry the current range and entity, omitting each at its default.
const withRange = (
  base: URLSearchParams,
  over: { entity?: EntityDimension } = {},
) => {
  const en = over.entity ?? entity;
  if (en !== "users") base.set("entity", en);
  const qs = base.toString();
  return qs ? `?${qs}` : "/trends";
};
const presetHref = (preset: Timeframe) => withRange(presetParams(preset));
const entityHref = (en: EntityDimension) =>
  withRange(rangeParams(range), { entity: en });

// Open the custom-dates panel when it's in use or needs correcting.
const customOpen = range.preset === null || range.error !== undefined;

// A tile whose figure didn't load shows "–" with no change chip, rather than a 0
// that reads as real (collapsed) usage. `usersUnavailable` is the narrower case
// where only the key->owner join failed, so just the people count is unknown.
const dataUnavailable = result.error !== undefined;
const usersUnavailable = result.usersUnavailable === true;
const tile = (
  label: string,
  value: string,
  delta: number | null,
  missing = dataUnavailable,
) => (missing ? { label, value: "–", delta: null } : { label, value, delta });

const stats = [
  tile(
    "Active users",
    totals.users.toLocaleString("en-GB"),
    pctChange(totals.users, prevTotals?.users),
    dataUnavailable || usersUnavailable,
  ),
  tile(
    "Active teams",
    totals.teams.toLocaleString("en-GB"),
    pctChange(totals.teams, prevTotals?.teams),
  ),
  tile(
    "Active keys",
    totals.keys.toLocaleString("en-GB"),
    pctChange(totals.keys, prevTotals?.keys),
  ),
  tile(
    "Requests",
    formatRequests(totals.requests),
    pctChange(totals.requests, prevTotals?.requests),
  ),
  tile(
    "Tokens",
    formatTokens(totals.tokens),
    pctChange(totals.tokens, prevTotals?.tokens),
  ),
  tile(
    "Spend",
    formatSpendCompact(totals.spend),
    pctChange(totals.spend, prevTotals?.spend),
  ),
];

// Environmental impact tiles. ecologits gives a low and high estimate per
// metric; the tiles show the midpoint and the caption gives the range, so a
// single figure never reads as a measurement. More is worse.
const impactUnavailable = dataUnavailable || modelList.error !== undefined;
const midTile = (
  label: string,
  key: "gwpKg" | "energyKwh",
  format: (n: number) => string,
) => ({
  ...tile(
    label,
    format(rangeMid(impact[key])),
    pctChange(rangeMid(impact[key]), rangeMid(prevImpact[key])),
    impactUnavailable,
  ),
  higherIsWorse: true,
});
const impactStats = [
  midTile("Carbon", "gwpKg", formatCo2),
  midTile("Electricity", "energyKwh", formatEnergy),
  {
    ...tile("Usage covered", `${coverageRounded}%`, null, impactUnavailable),
    higherIsWorse: false,
  },
];
const coverageNote =
  coverageRounded < 100
    ? ` The other ${100 - coverageRounded}% came from models ecologits does not yet cover.`
    : "";
const impactCaption = impactUnavailable
  ? ""
  : `Range: ${formatRange(impact.gwpKg, formatCo2)}, ${formatRange(impact.energyKwh, formatEnergy)}. Covers ${coverageRounded}% of output tokens.${coverageNote}`;

// Request reliability. The deltas read inverted - more failures or a higher
// rate is worse.
const reliabilityStats = [
  {
    ...tile(
      "Successful",
      formatRequests(totals.successful),
      pctChange(totals.successful, prevTotals?.successful),
    ),
    higherIsWorse: false,
  },
  {
    ...tile(
      "Failed",
      formatRequests(totals.failed),
      pctChange(totals.failed, prevTotals?.failed),
    ),
    higherIsWorse: true,
  },
  {
    ...tile(
      "Failure rate",
      formatFailureRate(totals.failed, totals.requests, 1),
      pctChange(totals.failureRate, prevTotals?.failureRate),
    ),
    higherIsWorse: true,
  },
];

// Chart titles name the bucket ("Tokens per week"), so no legend is needed.
const perUnit = { day: "per day", week: "per week", month: "per 30 days" }[
  granularity
];
const labels = trends.buckets.map((b) => b.date);
const spans = trends.buckets.map((b) => formatSpan(b));
const series = (label: string, data: number[]) => ({
  labels,
  spans,
  label,
  data,
});
---

<GovukLayout title="Gateway trends">
  <h1 class="govuk-heading-l">Gateway trends</h1>

  {(range.error || result.error) && (
    <ErrorSummary>
      <ErrorSummaryTitle>There is a problem</ErrorSummaryTitle>
      <ErrorSummaryBody>
        <ErrorSummaryList>
          {range.error && (
            <ErrorSummaryItem href={`#${range.error.field}`}>
              {range.error.message}
            </ErrorSummaryItem>
          )}
          {result.error && (
            <ErrorSummaryItem>
              Usage data couldn't be loaded: {result.error}
            </ErrorSummaryItem>
          )}
        </ErrorSummaryList>
      </ErrorSummaryBody>
    </ErrorSummary>
  )}

  <section class="app-trend-section">
    <div class="app-section-head">
      <h2 class="govuk-heading-m govuk-!-margin-bottom-0">Gateway overview</h2>
      <div class="app-range">
        <nav class="app-timeframe" aria-label="Time period">
          {TIMEFRAMES.map((p) => (
            <a
              href={presetHref(p.value)}
              class:list={[
                "govuk-body-s",
                "govuk-!-margin-bottom-0",
                "app-timeframe__option",
                {
                  "app-timeframe__option--selected":
                    p.value === range.preset && !range.error,
                },
              ]}
              aria-current={
                p.value === range.preset && !range.error ? "true" : undefined
              }
            >
              {p.label}
            </a>
          ))}
        </nav>

        <!-- Custom range: a plain GET form, so it works without JS. -->
        <Details
          class="govuk-!-margin-bottom-0 app-range__custom"
          open={customOpen}
        >
          <DetailsSummary>Choose dates</DetailsSummary>
          <DetailsText>
            <form method="get" novalidate>
              {entity !== "users" && (
                <input type="hidden" name="entity" value={entity} />
              )}
              <div class="app-range__fields">
                {[
                  { name: "from", label: "From", value: range.from },
                  { name: "to", label: "To", value: range.to },
                ].map((f) => (
                  <FormGroup
                    class:list={[
                      "govuk-!-margin-bottom-0",
                      {
                        "govuk-form-group--error":
                          range.error?.field === f.name,
                      },
                    ]}
                  >
                    <Label size="small" for={f.name}>
                      {f.label}
                    </Label>
                    {range.error?.field === f.name && (
                      <ErrorMessage id={`${f.name}-error`}>
                        {range.error.message}
                      </ErrorMessage>
                    )}
                    <Input
                      error={range.error?.field === f.name}
                      width="10"
                      id={f.name}
                      name={f.name}
                      type="date"
                      max={today}
                      value={f.value}
                      aria-describedby={
                        range.error?.field === f.name
                          ? `${f.name}-error`
                          : undefined
                      }
                    />
                  </FormGroup>
                ))}
                <Button secondary type="submit" class="govuk-!-margin-bottom-0">
                  Apply
                </Button>
              </div>
              <Hint class="govuk-!-margin-top-2 govuk-!-margin-bottom-0">
                Up to {MAX_CUSTOM_DAYS} days.
              </Hint>
            </form>
          </DetailsText>
        </Details>
      </div>
    </div>

    <p class="govuk-body app-range-summary">{rangeSummary}</p>

    <dl class="app-stat-grid" aria-label={rangeSummary}>
      {stats.map((s) => (
        <StatTile
          label={s.label}
          value={s.value}
          delta={s.delta}
          periodNoun={periodNoun}
        />
      ))}
    </dl>
  </section>

  <section class="app-trend-section">
    <div class="app-section-head">
      <h2 class="govuk-heading-m govuk-!-margin-bottom-0">
        Users and keys on the Gateway
      </h2>
      <nav class="app-timeframe" aria-label="Count active">
        {ENTITY_DIMENSIONS.map((d) => (
          <a
            href={entityHref(d.value)}
            class:list={[
              "govuk-body-s",
              "govuk-!-margin-bottom-0",
              "app-timeframe__option",
              { "app-timeframe__option--selected": d.value === entity },
            ]}
            aria-current={d.value === entity ? "true" : undefined}
          >
            {d.label}
          </a>
        ))}
      </nav>
    </div>
    {entity === "users" && usersUnavailable && !dataUnavailable && (
      <p class="govuk-body">
        Active users can't be shown right now because the key owner lookup
        failed. Switch to Teams for a count that isn't affected.
      </p>
    )}
    <TrendsChart
      id="trend-active"
      title={`Active ${entityMeta.noun} ${perUnit}`}
      chartData={series(`Active ${entityMeta.noun}`, trends.active[entity])}
      valueFormat="count"
    />
    <TrendsChart
      id="trend-keys"
      title={`Active keys ${perUnit}`}
      chartData={series("Active keys", trends.activeKeys)}
      valueFormat="count"
    />
  </section>

  <section class="app-trend-section">
    <h2 class="govuk-heading-m">Tokens and spend on the Gateway</h2>
    <TrendsChart
      id="trend-tokens"
      title={`Tokens ${perUnit}`}
      chartData={series("Tokens", trends.tokens)}
      valueFormat="tokens"
    />
    <TrendsChart
      id="trend-spend"
      title={`Spend ${perUnit}`}
      chartData={series("Spend", trends.spend)}
      valueFormat="spend"
    />
  </section>

  <section class="app-trend-section">
    <h2 class="govuk-heading-m">Environmental impact of the Gateway</h2>
    <p class="govuk-body">
      Estimated carbon and electricity for the tokens generated, from each
      model's size and the grid where it runs. Modelled, not measured, using{" "}
      <a class="govuk-link" href="https://ecologits.ai/" rel="noopener">
        ecologits
      </a>
    </p>
    <dl
      class="app-substat-grid govuk-!-margin-bottom-2"
      aria-label={`Environmental impact. ${rangeSummary}`}
    >
      {impactStats.map((s) => (
        <StatTile
          label={s.label}
          value={s.value}
          delta={s.delta}
          higherIsWorse={s.higherIsWorse}
          periodNoun={periodNoun}
        />
      ))}
    </dl>
    {impactCaption && (
      <p class="govuk-body-s govuk-!-margin-bottom-6">{impactCaption}</p>
    )}
    {impactUnavailable ? (
      <p class="govuk-body">
        The carbon chart can't be shown right now because the usage or model
        data didn't load.
      </p>
    ) : (
      /* Grams, so the compact tick formatter (5k, 10k) reads as 5kg, 10kg of CO2e. */
      <TrendsChart
        id="trend-emissions"
        title={`Carbon ${perUnit}, grams of CO₂e`}
        chartData={series(
          "Carbon (g CO₂e)",
          impactBuckets.map((b) => Math.round(rangeMid(b.gwpKg) * 1000)),
        )}
        valueFormat="count"
      />
    )}
  </section>

  <section class="app-trend-section">
    <h2 class="govuk-heading-m">Requests through the Gateway</h2>
    <dl
      class="app-substat-grid govuk-!-margin-bottom-6"
      aria-label={`Request reliability. ${rangeSummary}`}
    >
      {reliabilityStats.map((s) => (
        <StatTile
          label={s.label}
          value={s.value}
          delta={s.delta}
          higherIsWorse={s.higherIsWorse}
          periodNoun={periodNoun}
        />
      ))}
    </dl>
    <TrendsChart
      id="trend-requests"
      title={`Requests ${perUnit}`}
      chartData={series("Requests", trends.requests)}
      valueFormat="count"
    />
    <!-- Failures get their own chart so the axis scales to their range; on the
		     requests axis they'd flatten to the baseline. -->
    <TrendsChart
      id="trend-failures"
      title={`Failed requests ${perUnit}`}
      chartData={series("Failed requests", trends.failures)}
      valueFormat="count"
    />
  </section>
</GovukLayout>

<style>
  .app-trend-section {
    margin-bottom: 50px;
  }

  /* Section heading on the left, its control (period or users/teams) on the
  	   right, wrapping below on narrow screens. */
  .app-section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 15px 20px;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .app-range {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .app-range__custom {
    text-align: left;
  }

  .app-range__fields {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 15px;
  }

  .app-range-summary {
    text-align: right;
  }

  /* Headline tiles: six on one row on desktop, then 3 and 2 as the screen
  	   narrows, so a row never ends with a lone tile. No borders: spacing alone
  	   separates them. minmax(0,1fr) lets a track shrink below its content. */
  .app-stat-grid,
  .app-substat-grid {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .app-stat-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .app-stat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .app-stat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .app-substat-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 480px) {
    .app-substat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .app-range {
      align-items: flex-start;
    }

    .app-range-summary {
      text-align: left;
    }
  }

  /* Segmented control - matches the home page's app-timeframe. */
  .app-timeframe {
    display: inline-flex;
    flex-wrap: wrap;
    border: 1px solid var(--govuk-border-colour);
    border-radius: 4px;
    overflow: hidden;
  }

  .app-timeframe__option {
    padding: 8px 16px;
    color: var(--govuk-link-colour);
    text-decoration: none;
    border-left: 1px solid var(--govuk-border-colour);
  }

  .app-timeframe__option:first-child {
    border-left: 0;
  }

  .app-timeframe__option:hover:not(.app-timeframe__option--selected) {
    background-color: var(--govuk-surface-background-colour);
    color: var(--govuk-link-hover-colour);
  }

  .app-timeframe__option:focus-visible {
    outline: 3px solid var(--govuk-focus-colour);
    outline-offset: 0;
    box-shadow: none;
  }

  .app-timeframe__option--selected {
    background-color: var(--govuk-brand-colour);
    color: #ffffff;
    font-weight: 700;
  }
</style>
