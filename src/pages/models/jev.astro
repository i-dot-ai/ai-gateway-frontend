---
import GovukLayout from "../../layouts/GovukLayout.astro";
import TimeframeNav from "../../components/TimeframeNav.astro";
import UsageTabs from "../../components/UsageTabs.astro";
import {
  BackLink,
  InsetText,
  SummaryList,
  SummaryListRow,
  SummaryListKey,
  SummaryListValue,
} from "@i-dot-ai-npm/component-library-astro";
import { getJevCosts, type LitellmModel } from "../../lib/litellm";
import {
  DEFAULT_TIMEFRAME,
  getDateRange,
  parseTimeframe,
} from "../../lib/costs";
import { formatRequests, formatTokens, trimCompact } from "../../lib/usage";

// Jev is a gateway pass-through, not a LiteLLM model_list entry, so it never
// comes back from /v2/model/info. Its details are hardcoded here to match the
// fields the model page shows; anything TypeSafe/LiteLLM don't report is left
// unknown. This is a static route, so it shadows the dynamic /models/[id].
const jev: LitellmModel = {
  id: "jev",
  name: "jev-latest",
  provider: "TypeSafe",
  mode: "decision",
  litellm_model: "typesafe/jev-latest",
  location: "US",
  supports_vision: false,
  supports_function_calling: false,
  supports_audio_input: false,
  supports_reasoning: false,
  lab: "TypeSafe",
  country_of_origin: "US",
  open_weight: false,
  // $0.042 per 1M input tokens, no output charge (llm-prices.com / TypeSafe).
  input_cost_per_token: 0.000000042,
  output_cost_per_token: 0,
  uri: "https://docs.typesafe.ai/api",
  description:
    "TypeSafe's decision model. Instead of writing text, it returns a choice, a score or a yes/no probability, for classifying, routing or answering structured questions about some text.",
};

const timeframe = parseTimeframe(
  Astro.url.searchParams.get("timeframe"),
  DEFAULT_TIMEFRAME,
);
const { startDate, endDate } = getDateRange(timeframe);
const usage = await getJevCosts(startDate, endDate);
---

<GovukLayout title="Jev">
  <BackLink href="/models">Back</BackLink>

  <h1 class="govuk-heading-xl">{jev.name}</h1>
  <p class="govuk-body">{jev.description}</p>

  <div class="govuk-!-margin-bottom-8" id="usage">
    <h2 class="govuk-heading-m">Usage across the gateway</h2>
    <TimeframeNav current={timeframe} anchor="usage" />
    {usage.error ? (
      <p class="govuk-body">Usage is unavailable right now.</p>
    ) : usage.costs.length === 0 ? (
      <p class="govuk-body">No Jev usage has been recorded in this period.</p>
    ) : (
      <UsageTabs costs={usage.costs} timeframe={timeframe} breakdown="team" />
    )}
  </div>

  <h2 class="govuk-heading-m">Details</h2>
  <SummaryList>
    <SummaryListRow>
      <SummaryListKey>provider</SummaryListKey>
      <SummaryListValue>{jev.provider}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>mode</SummaryListKey>
      <SummaryListValue>{jev.mode}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>location</SummaryListKey>
      <SummaryListValue>{jev.location}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>lab</SummaryListKey>
      <SummaryListValue>{jev.lab}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>country of origin</SummaryListKey>
      <SummaryListValue>{jev.country_of_origin}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>open weight</SummaryListKey>
      <SummaryListValue>{jev.open_weight ? "yes" : "no"}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>impact</SummaryListKey>
      <SummaryListValue>
        Not estimated — the gateway has no environmental-impact figure for
        pass-through models.
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>uri</SummaryListKey>
      <SummaryListValue>
        <a href={jev.uri} class="govuk-link">
          {jev.uri}
        </a>
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>supports vision</SummaryListKey>
      <SummaryListValue>{jev.supports_vision ? "yes" : "no"}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>supports function calling</SummaryListKey>
      <SummaryListValue>
        {jev.supports_function_calling ? "yes" : "no"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>supports audio input</SummaryListKey>
      <SummaryListValue>
        {jev.supports_audio_input ? "yes" : "no"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>supports reasoning</SummaryListKey>
      <SummaryListValue>
        {jev.supports_reasoning ? "yes" : "no"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>max input tokens</SummaryListKey>
      <SummaryListValue>{jev.max_input_tokens ?? "unknown"}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>max output tokens</SummaryListKey>
      <SummaryListValue>{jev.max_output_tokens ?? "unknown"}</SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>tokens per minute limit</SummaryListKey>
      <SummaryListValue>
        {jev.tpm !== undefined
          ? `${trimCompact(formatTokens(jev.tpm))} tokens/min`
          : "no limit"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>requests per minute limit</SummaryListKey>
      <SummaryListValue>
        {jev.rpm !== undefined
          ? `${trimCompact(formatRequests(jev.rpm))} requests/min`
          : "no limit"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>cost per million input token</SummaryListKey>
      <SummaryListValue>
        {jev.input_cost_per_token !== undefined
          ? (jev.input_cost_per_token * 1e6).toFixed(2)
          : "unknown"}
      </SummaryListValue>
    </SummaryListRow>
    <SummaryListRow>
      <SummaryListKey>cost per million output token</SummaryListKey>
      <SummaryListValue>
        {jev.output_cost_per_token !== undefined
          ? (jev.output_cost_per_token * 1e6).toFixed(2)
          : "unknown"}
      </SummaryListValue>
    </SummaryListRow>
  </SummaryList>

  <InsetText>
    Jev is served through the gateway's <code class="app-code">/typesafe/</code>{" "}
    pass-through rather than as a model in the list, so it has no health status.
    See{" "}
    <a
      class="govuk-link"
      href="https://docs.typesafe.ai/api"
      rel="noopener noreferrer"
    >
      the TypeSafe API reference
    </a>{" "}
    for how to call it.
  </InsetText>
</GovukLayout>
