# Copy to `.env` before running:  cp .env.example .env
# Astro loads `.env` automatically, and src/middleware.ts calls dotenv/config.

# ---------------------------------------------------------------------------
# Local development — the values below match compose.yaml (see README).
# ---------------------------------------------------------------------------

# "local" bypasses ALB auth and signs every request in as LOCAL_USER_EMAIL.
# Anything else means "read the ALB's x-amzn-oidc-data header" (see middleware).
ENVIRONMENT=local

# The LiteLLM proxy the app talks to.
LITELLM_URL=http://localhost:4000
# LiteLLM master key. Must match LITELLM_MASTER_KEY in compose.yaml.
LITELLM_MASTER_KEY=sk-local-dev

# Dev-only identity used when ENVIRONMENT=local.
LOCAL_USER_EMAIL=test@example.gov.uk

# ---------------------------------------------------------------------------
# Required regardless of environment.
# src/lib/auth.ts throws at import time if AUTH_API_URL is unset, so even a
# local run needs a value. It is only actually called when ENVIRONMENT!=local.
# ---------------------------------------------------------------------------

# Base URL of the i.AI auth API that validates the ALB's OIDC token.
AUTH_API_URL=https://auth.example.gov.uk
# App name this frontend registers as with the auth API. Defaults to "unknown".
REPO=ai-gateway-frontend

# ---------------------------------------------------------------------------
# Optional — leave blank/omitted to disable the feature.
# ---------------------------------------------------------------------------

# PostHog analytics. Disabled unless POSTHOG_API_KEY is set and not "placeholder".
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Salt for the hashed (never raw) distinct ID sent to PostHog.
POSTHOG_DISTINCT_ID_SALT=core-llm-gateway-frontend

# OpenTelemetry log export. Off unless OTEL_ENABLED=true AND an endpoint is set.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=core-llm-gateway-frontend

# OIDC client ID used to build the sign-out redirect URL.
OIDC_CLIENT_ID=

# Default lifetime for generated API keys (LiteLLM duration string).
KEY_DURATION=60d

# Model overrides for the gateway's own LLM jobs. Defaults are shown.
MODEL_EXTRACT_MODEL=bedrock-claude-haiku-4-5-eu
MODEL_SEARCH_MODEL=gemini-3.5-flash-uk
MODEL_SEARCH_REASONING_EFFORT=minimal

# Set to any value to start the hourly model-details/arena refresh in dev.
# (It always runs when built for production.)
# MODEL_SEARCH_REFRESH=1

# Base URL for the optional model-search eval suite (MODEL_SEARCH_EVAL=1 to run).
# EVAL_BASE_URL=http://localhost:4321
